@model ASP.Models.Student

@{
    ViewData["Title"] = "Kết quả đăng ký";
}

<h1>Kết quả đăng ký</h1>

<div class="alert alert-success">
    <p>Cảm ơn bạn @Model.MSSV - @Model.HoTen đã đăng ký chuyên ngành @Model.ChuyenNganh</p>
</div>

<div class="alert alert-info">
    <p>Số lượng sinh viên đã đăng ký chuyên ngành giống bạn là: <strong>@ViewBag.SoLuong</strong></p>
</div>

<a href="/Student/Index" class="btn btn-secondary">Quay lại</a>
